{
  "name": "image-to-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Image → 3D illustration spec → three.js model library. Vite + React + three.js, Vercel Functions calling the Claude API.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "ANTHROPIC_MOCK=fixtures vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "serve:prod": "tsx scripts/serve-prod.ts",
    "fixtures": "node scripts/make-fixtures.mjs",
    "fixtures:images": "node scripts/make-fixture-images.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/stack-sans-headline": "^5.3.0",
    "@vercel/blob": "^2.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "tinypool": "^2.2.0"
  }
}
