# Copy to .env.local for `npm run dev`. On Vercel, add these with `vercel env add`.
# Nothing here is needed to run locally in mock mode: `npm run dev:mock`.

# --- required in production -------------------------------------------------
# Server-side only. Never prefixed with VITE_, never sent to the browser.
ANTHROPIC_API_KEY=
# Signs the Google sign-in state. Any long random string: `openssl rand -base64 32`.
SESSION_SECRET=
# Added automatically when you connect a Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Accounts, sessions and quotas live in Upstash Redis. Create a database (Vercel
# Marketplace → Upstash Redis) and it adds these. KV_REST_API_URL / KV_REST_API_TOKEN
# are read too. Without them, local dev uses a JSON file under DATA_DIR.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google sign-in: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorised redirect URI: https://3d.agamagarwal.com/api/auth?action=callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public origin, used to build the OAuth redirect URI. Default: the request's origin.
PUBLIC_URL=https://3d.agamagarwal.com

# --- beta access -------------------------------------------------------------
# Emails (comma separated) that are admins: they skip the invite gate and can open /admin.
ADMIN_EMAILS=
# Invite codes anyone can use to create an account (comma separated, reusable).
# Admins can also mint single-use codes at /admin. New accounts need a code when this
# is set, and always in production (INVITE_REQUIRED=false turns the gate off).
INVITE_CODES=
INVITE_REQUIRED=

# --- limits ------------------------------------------------------------------
# Free models per user per calendar month (UTC). A create run is one model, however many
# photos it uses; its compare-and-fix passes are free. Admins are unlimited. Default 5.
MONTHLY_MODELS=5
# Per-user cap on compute per UTC day, in USD. Default 2.
DAILY_USER_USD=2
# Generation requests running at once across the whole deployment; beyond it the API answers
# 503 "busy, retry". Default 4.
MAX_CONCURRENT=4
# Hard cap on Claude spend per UTC day, in USD, across all users. Default 5.
DAILY_BUDGET_USD=5
# Claude calls per minute per client IP (x-vercel-forwarded-for), counted in Redis. Default 12.
RATE_LIMIT_PER_MINUTE=12
# Upper bound on compare-and-fix passes the UI can request (0-3). Default 3.
MAX_REFINE_PASSES=3

# --- local development only (ignored in production) --------------------------
# "fixtures" replays recorded Claude responses: no key, no spend. It also turns on the
# password-less email sign-in on the login page.
ANTHROPIC_MOCK=
# 1 = the email sign-in without ANTHROPIC_MOCK (with a real key, say). Never works in production.
MOCK_AUTH=
MOCK_DELAY_MS=12
# Where the local file store and the local Kv file (kv.json) live.
DATA_DIR=.data
# 1 = let Claude write geometry code (customParts) and run it in the sandbox worker. Dev server
# only; also needs VITE_ALLOW_CUSTOM_PARTS=1 for the browser. Ignored in production builds.
ALLOW_CUSTOM_PARTS=
VITE_ALLOW_CUSTOM_PARTS=

# --- privacy and retention ---------------------------------------------------
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>` to /api/cron, which deletes
# source photos after 24 h and models after 30 days. Production refuses to run the job without it.
CRON_SECRET=
# Models a user can keep in their library at once. Default 50.
MAX_ITEMS_PER_USER=50
