# Copy to .env.local for `npm run dev`. On Vercel, add these with `vercel env add`.

# --- required in production -------------------------------------------------
# Server-side only. Never prefixed with VITE_, never sent to the browser.
ANTHROPIC_API_KEY=
# The shared password for the access gate. Without it, production is locked.
APP_PASSWORD=
# Signs session cookies. Any long random string: `openssl rand -base64 32`.
# Optional (falls back to a key derived from APP_PASSWORD), but set it so that
# changing the password and the session key are independent.
SESSION_SECRET=
# Added automatically when you connect a Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# --- optional ----------------------------------------------------------------
# Hard cap on Claude spend per UTC day, in USD. Default 5.
DAILY_BUDGET_USD=5
# Claude calls per minute per client IP (per server instance). Default 12.
RATE_LIMIT_PER_MINUTE=12
# Upper bound on compare-and-fix passes the UI can request (0-3). Default 3.
MAX_REFINE_PASSES=3
# true = the library and viewer are readable without the password (edits still need it).
PUBLIC_GALLERY=false

# --- local development only (ignored in production) --------------------------
# "fixtures" replays recorded Claude responses: no key, no spend.
ANTHROPIC_MOCK=
MOCK_DELAY_MS=12
# Where the local file store keeps the library when there is no Blob token.
DATA_DIR=.data
